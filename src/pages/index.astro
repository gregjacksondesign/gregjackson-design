---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects.js';
---

<Base
  title="gregjackson.design – product design portfolio"
  description="Greg Jackson — product designer. Eight years building and running design at Stockopedia, turning the complex world of financial markets into something anyone can understand."
>
  <section class="hero">
    <h1>Greg Jackson</h1>
    <p class="hero__role">Product designer &middot; UK, remote</p>
    <p class="hero__intro">
      I help people find the signal in the noise. Turning the complex world of
      financial markets into something a complete beginner can make sense of
      and actually enjoy — that's been my job for the last eight years,
      building and running design at Stockopedia.
    </p>
  </section>

  <section class="projects" aria-labelledby="projects-heading">
    <h2 id="projects-heading">Projects</h2>
    <div class="projects__grid">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>
</Base>

<style>
  /* The intro sits at --size-medium (24px on desktop), so it needs a wider
     container than 16px body copy to reach the same measure. 48rem puts it at
     roughly 68 characters per line. For reference: the original WordPress hero
     ran to about 84 characters, which read long, and 40rem here read short at
     about 53. */
  .hero {
    /* Top and bottom deliberately differ. The gap down to Projects stays at
       --gap-block — that's the space doing the "new block" work, and it's
       also what keeps the first card peeking above the fold on desktop.
       The gap up to the header drops one step to --gap-inner: with a quiet
       header above it, the larger token read as more of a pause than the
       identical --gap-block reads below the intro. */
    padding-top: var(--gap-inner);
    padding-bottom: var(--gap-block);
    max-width: 48rem;
  }

  /* The quiet metadata treatment from the original hero line, not the
     accent-rule .tag — a red underline read as too much emphasis for a
     byline sitting directly under the name. */
  .hero__role {
    margin-top: var(--space-12);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--colour-text-muted);
  }

  /* Tight, fixed gap from the byline above — this is one identity block
     (name, role, intro), not a run of independent sections, so it takes an
     inset-tier value rather than --gap-inner's block-level spacing.
     margin-bottom: 0 because this is now the last thing in .hero — the
     section's own padding-block closes the gap below. Doubling up here would
     repeat the padding-block bug from Experience/About. */
  .hero__intro {
    font-size: var(--size-medium);
    margin-block: var(--space-16) 0;
  }

  .projects {
    padding-bottom: var(--gap-block);
  }

  .projects h2 {
    margin-bottom: var(--gap-inner);
  }

  /* Three across on desktop, two on tablet, one on mobile. auto-fit means the
     last row fills naturally — the original needed empty placeholder columns
     to achieve this. */
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--gap-block) var(--gap-inner);
  }

  @media (min-width: 64rem) {
    .projects__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
