---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <hr class="separator" />

  {/* The one action a portfolio actually needs a button for. Everything else
      on the site is browsing; this is the moment someone decides to act. */}
  <p class="site-footer__cta">
    <a class="button" href="mailto:gw.jackson01@gmail.com"><span>Get in touch &nbsp;&rarr;</span></a>
  </p>

  <div class="site-footer__inner">
    <p>Greg Jackson &middot; Product design &middot; {year}</p>
    <p>
      <a href="https://www.linkedin.com/in/gregory-w-jackson" rel="noopener" target="_blank">LinkedIn</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--gap-block);
    padding-bottom: var(--gap-block);
  }

  .site-footer__cta {
    margin: 0;
    padding-top: var(--gap-inner);
  }

  .site-footer__inner {
    display: flex;
    justify-content: space-between;
    gap: var(--gap-inner);
    flex-wrap: wrap;
    padding-top: var(--gap-inner);
    font-size: var(--size-small);
    color: var(--colour-text-muted);
  }

  .site-footer__inner p {
    margin: 0;
  }
</style>
