---
// Two or more figures side by side, collapsing to a single column on mobile.
interface Props {
  columns?: number;
}
const { columns = 2 } = Astro.props;
---

<div class="figure-grid" style={`--columns: ${columns};`}>
  <slot />
</div>

<style>
  .figure-grid {
    display: grid;
    gap: var(--gap-inner);
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .figure-grid {
      grid-template-columns: repeat(var(--columns), 1fr);
    }
  }

  .figure-grid :global(.figure) {
    max-width: none;
  }
</style>
