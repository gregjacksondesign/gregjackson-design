---
// Site navigation. Links match the original site's routes exactly, so any
// existing links to gregjackson.design keep working.
//
// LinkedIn sits apart from the three page links: it's the only item that
// navigates away from the site, so it reads as an icon rather than a fourth
// destination. That also keeps everything on one row at 375px, which four text
// labels could not do.
const links = [
  { href: '/', label: 'Projects' },
  { href: '/experience/', label: 'Experience' },
  { href: '/about-me/', label: 'About me' },
];

const linkedInUrl = 'https://www.linkedin.com/in/gregory-w-jackson';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <a class="site-logo" href="/">
    <img src="/images/gj-logo-circle.png" alt="" width="32" height="32" />
    <span>gregjackson.design</span>
  </a>

  <nav class="site-nav" aria-label="Main">
    {links.map((link) => (
      <a
        class="nav-link"
        href={link.href}
        aria-current={isCurrent(link.href) ? 'page' : undefined}
      >
        {link.label}
      </a>
    ))}

    <a class="nav-link nav-link--icon" href={linkedInUrl} rel="noopener" target="_blank">
      {/* Accessible name as real text rather than aria-label — it's translatable
          and read reliably by every screen reader. */}
      <span class="visually-hidden">LinkedIn (opens in a new tab)</span>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
        />
      </svg>
    </a>
  </nav>
</header>
