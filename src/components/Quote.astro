---
// A customer or colleague quote. Marked up as a real blockquote so it carries
// meaning to screen readers, not just visual styling.
interface Props {
  attribution?: string;
}
const { attribution } = Astro.props;
---

<figure class="quote">
  <blockquote>
    <slot />
  </blockquote>
  {attribution && <figcaption>{attribution}</figcaption>}
</figure>

<style>
  /* Measured from the WordPress original: a filled panel with a 4px accent
     rule down the left edge and even padding all round. It fills the whole
     content column rather than the narrower running-text measure, so quotes
     sit slightly wider than the paragraphs around them. */
  .quote {
    margin: 0;
    padding: var(--space-24);
    border-left: 4px solid var(--colour-accent);
    background-color: color-mix(in srgb, var(--colour-black) 3%, transparent);
  }

  /* Italic serif at body size — not --size-medium. On the original the quote
     text sits on the same 25.6px baseline as the body copy around it. */
  .quote blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--size-small);
    font-style: italic;
    color: var(--colour-text);
  }

  .quote blockquote :global(p:last-child) {
    margin-bottom: 0;
  }

  .quote figcaption {
    margin-top: var(--space-12);
    font-family: var(--font-body);
    font-style: normal;
    font-size: var(--size-small);
    color: var(--colour-text-muted);
  }
</style>
